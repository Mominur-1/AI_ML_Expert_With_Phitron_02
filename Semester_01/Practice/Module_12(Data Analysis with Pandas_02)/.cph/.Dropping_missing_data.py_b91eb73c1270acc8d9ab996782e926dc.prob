{"name":"Dropping missing data","group":"CodeChef - Learn Pandas - Practice Problems and Challenges","url":"https://www.codechef.com/learn/course/pandas/LPDP06/problems/LPDPR28?tab=statement","interactive":false,"memoryLimit":256,"timeLimit":1000,"tests":[{"id":1785140548618,"input":"# Drop rows with any missing values\ndf_clean = df.dropna()\n\n# Drop rows only if all values are missing\ndf_clean = df.dropna(how='all')\n\n# Drop rows with less than 2 non-null values\ndf_clean = df.dropna(thresh=2)\n\n# Drop rows where column 'A' has missing values\ndf_clean = df.dropna(subset=['A'])\n\n# Drop rows where either 'A' or 'B' is missing\ndf_clean = df.dropna(subset=['A', 'B'], how='any')\n","output":"     A     B     C\n0  1.0   5.0     a\n1  2.0   NaN     b\n2  NaN   NaN     c\n3  4.0   NaN  None\n4  5.0  10.0     e\n     A     B     C\n0  1.0   5.0     a\n1  2.0   NaN     b\n3  4.0   NaN  None\n4  5.0  10.0     e\n     A     B  C\n0  1.0   5.0  a\n1  2.0   NaN  b\n4  5.0  10.0  e\n     A     B     C\n0  1.0   5.0     a\n1  2.0   NaN     b\n3  4.0   NaN  None\n4  5.0  10.0     e\n"}],"testType":"single","input":{"type":"stdin"},"output":{"type":"stdout"},"languages":{"java":{"mainClass":"Main","taskClass":"DroppingMissingData"}},"batch":{"id":"a8faea9e-68f6-4f60-ad18-39082e1b9d90","size":1},"srcPath":"d:\\Learning_Courses\\AI_ML_Expert_With_Phitron_02\\Semester_01\\Week_04(Ml_Toolbox(Ml_Visualization))\\Practice_day\\Module_12(Data Analysis with Pandas_02)\\Dropping_missing_data.py"}