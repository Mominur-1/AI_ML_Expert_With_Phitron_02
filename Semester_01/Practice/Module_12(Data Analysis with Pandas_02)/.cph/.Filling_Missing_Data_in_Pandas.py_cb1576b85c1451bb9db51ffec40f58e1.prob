{"name":"Filling Missing Data in Pandas","group":"CodeChef - Learn Pandas - Practice Problems and Challenges","url":"https://www.codechef.com/learn/course/pandas/LPDP06/problems/LPDPR29?tab=statement","interactive":false,"memoryLimit":256,"timeLimit":1000,"tests":[{"id":1785127318668,"input":"# Fill all missing values with 0\ndf_filled = df.fillna(0)\n\n# Fill different values for different columns\ndf_filled = df.fillna({'A': 0, 'B': 99, 'C': 'Unknown'})\n\n# Forward fill - This method propagates the last valid observation forward to next missing value\ndf_ffilled = df.ffill()\n\n# Backward fill - This method uses the next valid observation to fill the gap.\ndf_bfilled = df.bfill()\n\n# You can fill missing values with statistical measures like mean, median, or mode.\ndf['A'].fillna(df['A'].mean(), inplace=True)\ndf['B'].fillna(df['B'].median(), inplace=True)\n","output":"     A     B     C\n0  1.0   5.0     a\n1  2.0   NaN     b\n2  NaN   NaN     c\n3  4.0   NaN  None\n4  5.0  10.0     e\n     A     B        C\n0  1.0   5.0        a\n1  2.0  99.0        b\n2  0.0  99.0        c\n3  4.0  99.0  Unknown\n4  5.0  10.0        e\n     A     B     C\n0  1.0   5.0     a\n1  2.0   5.0     b\n2  NaN   5.0     c\n3  4.0   5.0  None\n4  5.0  10.0     e\n     A     B        C\n0  1.0   5.0        a\n1  2.0   7.5        b\n2  3.0   7.5        c\n3  4.0   7.5  Unknown\n4  5.0  10.0        e\n"}],"testType":"single","input":{"type":"stdin"},"output":{"type":"stdout"},"languages":{"java":{"mainClass":"Main","taskClass":"FillingMissingDataInPandas"}},"batch":{"id":"7aef5b57-c3ed-428d-bfe2-3d1e16f3dac3","size":1},"srcPath":"d:\\Learning_Courses\\AI_ML_Expert_With_Phitron_02\\Semester_01\\Week_04(Ml_Toolbox(Ml_Visualization))\\Practice_day\\Module_12(Data Analysis with Pandas_02)\\Filling_Missing_Data_in_Pandas.py"}